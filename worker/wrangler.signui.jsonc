{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 第二套实例：与 wrangler.jsonc 同一份代码、独立 KV 与域名
  // 部署：npx wrangler deploy --config wrangler.signui.jsonc
  "name": "signui-work",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 自定义域名：DNS 记录由 Cloudflare 自动创建（zone 需在本账号下）
  "routes": [
    {
      "pattern": "signui.example.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      // wrangler kv namespace create signui-kvdb
      "binding": "CERTUM_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
