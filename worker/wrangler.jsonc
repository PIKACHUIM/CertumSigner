{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "certum-signer",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 自定义域名：DNS 记录由 Cloudflare 自动创建（zone 需在本账号下）
  "routes": [
    {
      "pattern": "sign.example.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      // wrangler kv namespace create CERTUM_KV
      "binding": "CERTUM_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
  // 其余配置都在后台「系统设置 → 服务与地址」里改（存 KV）：
  //   基础地址 / Certum API / TSA / 发件人 / 中间证书 PEM / 签名明细日志
  // 只保留两个可选 secret：
  //   SESSION_SECRET    会话签名密钥（不设则用初始化时生成在 KV 的随机值）
  //   RESEND_API_KEY    发信 Key（不设则注册/找回密码不可用）
}
