{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 这是模板，真实域名与 KV id 请换成自己的。
  // 需要多套实例时，把本文件复制成 wrangler.<名字>.jsonc 再用 --config 指定；
  // worker/.gitignore 已忽略 wrangler.*.jsonc，带真实值的配置不会被提交。
  "name": "certum-signer",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 自定义域名：换成自己的域名（zone 需在本账号下），DNS 记录由 Cloudflare 自动创建。
  // 不需要自定义域名就整段删掉，Worker 会使用 <name>.<subdomain>.workers.dev。
  // "routes": [
  //   {
  //     "pattern": "sign.your-domain.com",
  //     "custom_domain": true
  //   }
  // ],
  "kv_namespaces": [
    {
      // 先执行 npx wrangler kv namespace create CERTUM_KV，把返回的 id 填到这里
      "binding": "CERTUM_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
  // 其余配置都在后台「系统设置 → 服务与地址」里改（存 KV）：
  //   基础地址 / Certum API / TSA / 发件人 / 中间证书 PEM / 签名明细日志
  // 只保留两个可选 secret：
  //   SESSION_SECRET    会话签名密钥（不设则用初始化时生成在 KV 的随机值）
  //   RESEND_API_KEY    发信 Key（不设则注册/找回密码不可用）
}
